# ================================================================
# KAMLOG Backend — Nginx Production Configuration
# ================================================================
# Place this in /etc/nginx/sites-available/kamlog-api
# Symlink: ln -s /etc/nginx/sites-available/kamlog-api /etc/nginx/sites-enabled/
# Test: nginx -t && systemctl reload nginx
# ================================================================

# Rate limiting zones (before server block)
limit_req_zone $binary_remote_addr zone=api_global:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api_uploads:10m rate=10r/m;

server {
    listen 80;
    server_name api.kamlog.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.kamlog.com;
    root /var/www/kamlog-backend/public;
    index index.php;

    # ── SSL Configuration ────────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/api.kamlog.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.kamlog.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # ── Logging ──────────────────────────────────────────────────
    access_log /var/log/nginx/kamlog-api-access.log combined buffer=512k flush=1m;
    error_log  /var/log/nginx/kamlog-api-error.log warn;

    # ── General Settings ─────────────────────────────────────────
    charset utf-8;
    client_max_body_size 20M;
    client_body_timeout 30s;
    client_header_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 65;

    # ── Gzip Compression ─────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        application/json
        application/javascript
        application/xml
        text/css
        text/plain
        text/xml;

    # ── Security Headers (Nginx-level backup) ────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Hide server tokens ───────────────────────────────────────
    server_tokens off;

    # ── Static files caching ─────────────────────────────────────
    location ~* \.(jpg|jpeg|png|gif|webp|ico|svg|css|js|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # ── Block sensitive files ────────────────────────────────────
    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~ \.(env|log|sql|bak)$ {
        deny all;
    }

    # ── Health check (no rate limit) ─────────────────────────────
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    # ── API rate limiting zones ──────────────────────────────────
    location ~ ^/api/v1/admin/auth/login$ {
        limit_req zone=api_login burst=3 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location ~ ^/api/v1/(upload|files) {
        limit_req zone=api_uploads burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    # ── Main location ────────────────────────────────────────────
    location / {
        limit_req zone=api_global burst=20 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ── PHP-FPM ──────────────────────────────────────────────────
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;

        # Performance tuning
        fastcgi_buffering on;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 16 16k;
        fastcgi_connect_timeout 10s;
        fastcgi_send_timeout 30s;
        fastcgi_read_timeout 30s;

        # Hide PHP version
        fastcgi_hide_header X-Powered-By;
    }

    # ── Deny access to artisan, composer, etc. ───────────────────
    location ~ ^/(artisan|composer\.(json|lock)|package\.json|webpack\.mix\.js|phpunit\.xml) {
        deny all;
    }
}
