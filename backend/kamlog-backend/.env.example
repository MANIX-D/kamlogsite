# ╔══════════════════════════════════════════════════════════════╗
# ║             KAMLOG Backend — .env.example                   ║
# ║  Copier ce fichier vers .env et remplir toutes les valeurs  ║
# ║  NE JAMAIS committer .env avec de vraies valeurs !          ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────
APP_NAME=KAMLOG
APP_ENV=local                          # production | staging | local
APP_KEY=                               # ⚠️ Obligatoire: php artisan key:generate
APP_DEBUG=false                        # ⚠️ MUST be false in production
APP_URL=https://api.kamlog.com
FRONTEND_URL=https://kamlog.com
APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# ── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12                       # 12+ recommandé en production

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                      # 'debug' en local, 'warning' en production
LOG_DAILY_DAYS=14
LOG_API_REQUESTS=false
LOG_SLOW_QUERY_MS=500

# ── Database ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kamlog
DB_USERNAME=                           # ⚠️ À définir
DB_PASSWORD=                           # ⚠️ À définir — utiliser un mot de passe fort
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Cache ────────────────────────────────────────────────────
CACHE_STORE=redis                      # 'redis' recommandé en production

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true            # true en production (HTTPS requis)
SESSION_SAME_SITE=lax

# ── Queue ────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Redis ────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=                        # ⚠️ À définir en production
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                         # ⚠️ Adresse email expéditeur
MAIL_PASSWORD=                         # ⚠️ Mot de passe d'application Gmail uniquement
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=                     # ⚠️ Même email que MAIL_USERNAME
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ───────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://kamlog.com,https://www.kamlog.com  # ⚠️ Domaines frontend autorisés

# ── Sanctum (API Token Auth) ────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=kamlog.com,www.kamlog.com  # ⚠️ Domaines SPA autorisés
SANCTUM_EXPIRATION=1440                # Token lifetime en minutes (24h)
SANCTUM_TOKEN_PREFIX=kamlog_

# ── Trusted Proxies ─────────────────────────────────────────
TRUSTED_PROXIES=                       # ⚠️ IPs spécifiques en production

# ── Storage Quotas ─────────────────────────────────────────
STORAGE_QUOTA_IMAGES_MB=500
STORAGE_QUOTA_CVS_MB=200
STORAGE_QUOTA_DOCUMENTS_MB=200
