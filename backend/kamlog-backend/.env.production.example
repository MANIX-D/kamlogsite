# ================================================================
# KAMLOG Backend — Production Environment Configuration
# ================================================================
# Copy this file to .env and fill in all values marked with <CHANGE>
# NEVER commit the actual .env file to version control.
# Run: php artisan key:generate --force  (once after first deploy)
# ================================================================

# ── Application ──────────────────────────────────────────────────
APP_NAME="KAMLOG API"
APP_ENV=production
APP_KEY=                              # <CHANGE> Run: php artisan key:generate
APP_DEBUG=false                       # MUST be false in production
APP_TIMEZONE=UTC
APP_URL=https://api.kamlog.com        # <CHANGE> Your API domain
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# ── Database (MySQL) ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                     # <CHANGE> DB host
DB_PORT=3306
DB_DATABASE=kamlog_production         # <CHANGE> DB name
DB_USERNAME=kamlog_user               # <CHANGE> DB user (not root!)
DB_PASSWORD=                          # <CHANGE> Strong password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PERSISTENT=true                    # Persistent connections for performance
# DB_READ_HOST=                       # Optional: comma-separated read replica hosts
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem  # Optional: SSL for remote DB

# ── Redis ────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis                 # phpredis (C ext) is faster than predis
REDIS_HOST=127.0.0.1                  # <CHANGE> Redis host
REDIS_PASSWORD=null                   # <CHANGE> Set a password in production
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=kamlog_

# ── Cache / Session / Queue (all Redis-backed) ──────────────────
CACHE_STORE=redis                     # Redis > database > file for production
SESSION_DRIVER=redis
SESSION_LIFETIME=120                  # Minutes
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

# ── Logging ──────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily                       # Use 'daily,slack' to add Slack alerts
LOG_LEVEL=warning                     # warning for prod (info if you need more detail)
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=daily
LOG_API_REQUESTS=false                # Enable for debugging, disable to reduce I/O

# Slack alerting (optional — receives critical/error logs)
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp                      # <CHANGE> smtp, ses, postmark, resend
MAIL_HOST=                            # <CHANGE> SMTP host
MAIL_PORT=587
MAIL_USERNAME=                        # <CHANGE>
MAIL_PASSWORD=                        # <CHANGE>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@kamlog.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://kamlog.com,https://www.kamlog.com,https://admin.kamlog.com

# ── Sanctum (API tokens) ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=kamlog.com,www.kamlog.com,admin.kamlog.com
SANCTUM_EXPIRATION=1440               # 24 hours
SANCTUM_TOKEN_PREFIX=kamlog_

# ── Security ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
TRUSTED_PROXIES=*                     # <CHANGE> Set to your LB/proxy IPs or '*'

# ── Filesystem ───────────────────────────────────────────────────
FILESYSTEM_DISK=local
# For S3/cloud storage (optional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# AWS_BUCKET=kamlog-uploads
